# GEMINI_API_KEY: Required for Gemini AI investigation calls (optional; offline forensics works without it).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MobileTrace AI Workstation Paths & Settings
MOBILETRACE_DB_PATH="./data/mobiletrace.db"
MOBILETRACE_WORKSPACE_DIR="./data/workspace"
MOBILETRACE_ADB_PATH=""
MOBILETRACE_IDEVICE_DIR=""
MOBILETRACE_ALEAPP_PATH=""
MOBILETRACE_ILEAPP_PATH=""
MOBILETRACE_MVT_IOS_PATH=""
MOBILETRACE_MVT_ANDROID_PATH=""
MOBILETRACE_GEMINI_MODEL="gemini-4-hydrogen"
MOBILETRACE_REDACT_PII="true"

# Optional web server settings
# PORT=3000
# MOBILETRACE_HOST=127.0.0.1   # use 127.0.0.1 to keep the console reachable only from this PC (default: 0.0.0.0)
